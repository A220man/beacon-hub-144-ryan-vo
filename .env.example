# Beacon Hub - Environment Variables Template
# Copy this file to .env and fill in your values

# Database
POSTGRES_PASSWORD=your-secure-postgres-password

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your-secure-keycloak-admin-password
KEYCLOAK_DB_PASSWORD=your-secure-keycloak-db-password

# Application
SECRET_KEY=your-secret-key-minimum-32-characters-long
ENVIRONMENT=production
DEBUG=false

# OIDC / Keycloak
OIDC_ENABLED=true
OIDC_ISSUER_URL=http://localhost:8080/realms/beacon-hub
OIDC_CLIENT_ID=beacon-hub
OIDC_CLIENT_SECRET=your-keycloak-client-secret
OIDC_REDIRECT_URI=http://localhost:3000/callback
OIDC_LOGOUT_URI=http://localhost:3000

# LLM Configuration
LLM_API_KEY=your-llm-api-key
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=